rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email.lower() == '039698329@tzviama.com' ||
        request.auth.token.email.lower() == 'chepti@gmail.com'
      );
    }
    function bootstrapping() {
      return !exists(/databases/$(database)/documents/content/app);
    }
    function knownTeacher(email) {
      return exists(/databases/$(database)/documents/teachers/$(email));
    }

    match /content/{doc} {
      allow read: if true;
      allow write: if isAdmin() || bootstrapping();
    }

    match /teachers/{id} {
      allow read: if true;
      allow create: if isAdmin() || bootstrapping() ||
        request.resource.data.email.lower() == id.lower();
      allow update, delete: if isAdmin() || bootstrapping();
    }

    match /responses/{id} {
      allow read: if true;
      allow create, update: if knownTeacher(request.resource.data.teacherId);
      allow delete: if isAdmin();
    }

    match /rsvps/{id} {
      allow read: if true;
      allow create, update: if knownTeacher(request.resource.data.teacherId);
      allow delete: if isAdmin();
    }

    match /reactions/{id} {
      allow read: if true;
      allow create, update: if knownTeacher(request.resource.data.teacherId);
      allow delete: if isAdmin();
    }

    match /aggregates/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
